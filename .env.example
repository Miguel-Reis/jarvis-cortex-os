# Server-side Gemini API key (automatically injected via AI Studio Settings > Secrets, or defined here locally)
GEMINI_API_KEY=

# Optional server-side OpenRouter / OpenAI-compatible API key when modelProvider is OPENROUTER_COMPAT
# Note: Local OpenAI-compatible servers (LM Studio :1234/v1, vLLM :8000/v1) do not require a key.
OPENROUTER_API_KEY=

# Full Debug Logging (enabled by default; set JARVIS_DEBUG=0 to silence, JARVIS_DEBUG_ASSETS=1 to also log Vite static assets)
JARVIS_DEBUG=1
JARVIS_DEBUG_ASSETS=0
JARVIS_HTTP_VERBOSE=1


