# ============================================================================
# J.A.R.V.I.S. Cortex OS v4.0 — Environment Configuration (.env.example)
# ============================================================================

# Network & Authentication (A-01 Security Gate)
# Default bind host is 127.0.0.1 (loopback). If binding to 0.0.0.0 on a LAN,
# JARVIS_API_TOKEN is MANDATORY (enforced at boot).
HOST=127.0.0.1
PORT=3000
JARVIS_API_TOKEN=
JARVIS_CORS_ORIGIN=

# Seed & Governance Mode (A-04 / A-06)
# SEED_MODE=demo includes labeled [DEMO SEED] sample runs; SEED_MODE=real boots with clean zeroed runs.
SEED_MODE=demo
JARVIS_TRUST_THRESHOLD=70
JARVIS_FREEZE_STATE=0

# Server-side Gemini API key (automatically injected in AI Studio, or set locally)
GEMINI_API_KEY=

# Optional server-side OpenRouter / OpenAI-compatible API key when modelProvider is OPENROUTER_COMPAT
# Local OpenAI-compatible servers (LM Studio :1234/v1, vLLM :8000/v1) do not require a key.
OPENROUTER_API_KEY=

# Debug Logging with automatic secret redaction & daily 7-day log rotation (A-11)
JARVIS_DEBUG=1
JARVIS_DEBUG_ASSETS=0
JARVIS_HTTP_VERBOSE=1
