# Optional Gemini API key (automatically injected by Google AI Studio)
GEMINI_API_KEY=

# Optional OpenRouter server-side API key when modelProvider is OPENROUTER_COMPAT
OPENROUTER_API_KEY=

# Full Debug Logging (enabled by default; set JARVIS_DEBUG=0 to silence, JARVIS_DEBUG_ASSETS=1 to also log Vite static assets)
JARVIS_DEBUG=1
JARVIS_DEBUG_ASSETS=0
JARVIS_HTTP_VERBOSE=1

